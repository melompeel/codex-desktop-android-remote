<Window x:Class="CodexRemoteManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Remote 管理器" Width="760" Height="720" MinWidth="680" MinHeight="620"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="46" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/app-icon.png" Width="38" Height="38" Margin="0,0,12,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Codex Remote" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="Windows 桌面 Bridge 管理器" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="OverallDot" Width="9" Height="9" Fill="#9AA3A0" Margin="0,0,8,0" />
                    <TextBlock x:Name="OverallStatusText" Text="正在检查" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="18">
                        <StackPanel>
                            <TextBlock Text="运行状态" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,14" />
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Bridge" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Grid.Column="1" x:Name="BridgeStatusText" Text="未运行" FontWeight="SemiBold" />
                            </Grid>
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="桌面连接 IPC" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Grid.Column="1" x:Name="IpcStatusText" Text="--" FontWeight="SemiBold" />
                            </Grid>
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Codex Desktop" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Grid.Column="1" x:Name="DesktopVersionText" Text="--" TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Expander x:Name="DeviceExpander" IsEnabled="False">
                                <Expander.Header>
                                    <Grid Width="260">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="已授权设备" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Grid.Column="1" x:Name="DeviceCountText" Text="--" />
                                    </Grid>
                                </Expander.Header>
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,6,0,0">
                                    <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="DeviceItems">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,5">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11">
                                                                <Run Text="{Binding KindLabel}"/><Run Text="  ·  "/><Run Text="{Binding AuthorizedAtLabel}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Tag="{Binding}" Click="RevokeDevice_Click" Width="30" Height="30" MinHeight="30" Padding="0" ToolTip="删除授权设备">
                                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" FontSize="13" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="手机配对码" FontSize="14" FontWeight="SemiBold" />
                            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="PairingCodeText" Text="------" FontFamily="Consolas" FontSize="34" FontWeight="SemiBold" />
                                <TextBlock x:Name="PairingExpiryText" Text="启动后显示" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="复制" Click="CopyPairing_Click" Margin="0,0,8,0" />
                                <Button Content="换一个配对码" Click="RotatePairing_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,16,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="手机连接地址" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="优先使用 Tailscale；同一网络下也可以使用局域网地址。" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="监听 IP" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="ListenIpText" Text="0.0.0.0" FontFamily="Consolas" Margin="8,0,16,0" VerticalAlignment="Center" />
                                <TextBlock Text="端口" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                <TextBox x:Name="PortTextBox" Text="8766" Width="62" Height="30" Margin="8,0,0,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <ItemsControl x:Name="AddressItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding KindLabel}" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Url}" FontFamily="Consolas" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0" />
                                        <Button Grid.Column="2" Content="复制" Tag="{Binding Url}" Click="CopyAddress_Click" MinHeight="30" Padding="12,4" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="NoAddressText" Text="Bridge 启动后会自动列出当前电脑可用的 IP 和完整地址。" Foreground="{StaticResource MutedBrush}" Margin="0,5" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button x:Name="StartButton" Content="启动 Bridge" Style="{StaticResource PrimaryButton}" Click="Start_Click" Margin="0,0,8,0" />
                    <Button x:Name="StopButton" Content="停止" Click="Stop_Click" Margin="0,0,8,0" />
                    <Button x:Name="RestartButton" Content="重新启动" Click="Restart_Click" Margin="0,0,8,0" />
                    <Button Content="打开 Codex Desktop" Click="OpenCodex_Click" />
                </StackPanel>

                <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <CheckBox x:Name="AutostartCheckBox" Content="登录 Windows 后自动启动" Checked="Autostart_Changed" Unchecked="Autostart_Changed" />
                        <CheckBox Grid.Column="1" x:Name="CloseToTrayCheckBox" Content="关闭窗口后在系统托盘继续运行" IsChecked="True" Checked="CloseToTray_Changed" Unchecked="CloseToTray_Changed" />
                    </Grid>
                </Border>

                <Expander Header="运行日志" Margin="0,16,0,0" IsExpanded="False">
                    <TextBox x:Name="LogTextBox" Margin="0,8,0,0" Height="110" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#101714" Foreground="#D9E6E1" BorderThickness="0" Padding="10" FontFamily="Consolas" FontSize="12" />
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="24,0">
                <TextBlock x:Name="FooterText" Text="Bridge 未运行" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                <TextBlock Text="关闭此窗口不会断开手机" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</Window>
